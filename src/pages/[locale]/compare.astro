---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LegacyLocaleNotice from '../../components/LegacyLocaleNotice.astro';
import { getCatalog } from '../../lib/catalog';
import { locales, isLocale } from '../../lib/locales';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const requested = Astro.params.locale;
if (!isLocale(requested)) throw new Error('Unsupported locale');
const locale = requested;
const { tools, categories } = await getCatalog();
const categoryNames = Object.fromEntries(categories.map((category) => [category.id, category.name]));
const comparisonData = tools.map((tool) => ({
  id: tool.id,
  name: tool.name,
  url: tool.url,
  description: tool.description,
  category: categoryNames[tool.category] ?? tool.category,
  subcategory: tool.subcategory?.name ?? null,
  pricing: tool.pricing,
  openSource: tool.openSource,
}));
const serialized = JSON.stringify(comparisonData).replace(/</g, '\\u003c');
---
<BaseLayout title="Compare tools" description="Compare up to three AI tools side by side using recorded catalog metadata." locale={locale} noindex={true}>
  <LegacyLocaleNotice locale={locale} />

  <section class="compare-page">
    <p class="kicker">Decision support</p>
    <h1>Compare tools</h1>
    <p>Compare only what the catalog actually records. Unknown fields stay unknown rather than being filled with guesses.</p>

    <div id="compare-empty" class="empty-state compare-empty">
      <strong>No tools selected.</strong>
      Add up to three tools from the directory, then return here.
      <div class="actions-row">
        <a class="primary-button" href={'/' + locale + '/#directory'}>Browse tools</a>
      </div>
    </div>

    <div id="compare-content" hidden>
      <div id="compare-grid" class="compare-grid"></div>
      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead id="compare-head"></thead>
          <tbody id="compare-body"></tbody>
        </table>
      </div>
    </div>
  </section>

  <script id="compare-data" type="application/json" set:html={serialized}></script>
  <script>
    import { initComparePage } from '../../scripts/compare-page';
    initComparePage();
  </script>
</BaseLayout>
