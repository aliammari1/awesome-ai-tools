---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../lib/locales';
import { englishCanonicalPath } from '../lib/locales';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  noindex?: boolean;
}

const {
  title,
  description,
  locale = 'en',
  noindex = locale !== 'en',
} = Astro.props;

const canonicalPath = englishCanonicalPath(Astro.url.pathname, locale);
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const fullTitle = title === 'Awesome AI Tools' ? title : title + ' · Awesome AI Tools';
const contentLanguage = locale === 'en' ? 'en' : 'en';
---
<!doctype html>
<html lang={contentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome AI Tools" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101216" media="(prefers-color-scheme: dark)" />
  </head>
  <body data-locale={locale}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header locale={locale} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <div class="compare-tray" data-compare-tray hidden>
      <p><strong><span data-compare-count>0</span> selected</strong> · Compare up to three tools side by side.</p>
      <button class="control-button" type="button" data-clear-compare>Clear</button>
      <a class="primary-button" href={'/' + locale + '/compare/'} data-compare-link>Compare</a>
    </div>
    <div class="sr-only" aria-live="polite" aria-atomic="true" data-site-status></div>

    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
