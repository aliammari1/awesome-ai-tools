---
interface Props {
  tool: {
    id: string;
    name: string;
    url: string;
    description: string;
    category: string;
    subcategory: { id: string; name: string } | null;
    order: number;
    openSource: boolean | null;
    pricing: 'free' | 'freemium' | 'paid' | 'contact-sales' | null;
  };
  locale?: string;
  categoryName?: string;
}

const { tool, locale = 'en', categoryName = tool.category } = Astro.props;
const initials = tool.name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('');

const pricingLabel: Record<string, string> = {
  free: 'Free',
  freemium: 'Freemium',
  paid: 'Paid',
  'contact-sales': 'Contact sales',
};

const detailHref = '/' + locale + '/tools/' + tool.id + '/';
const searchText = [
  tool.name,
  tool.description,
  categoryName,
  tool.subcategory?.name ?? '',
].join(' ').toLowerCase();
---
<article
  class="tool-card"
  data-tool-card
  data-tool-id={tool.id}
  data-name={tool.name.toLowerCase()}
  data-category={tool.category}
  data-subcategory={tool.subcategory?.id ?? ''}
  data-pricing={tool.pricing ?? 'unknown'}
  data-open-source={tool.openSource === true ? 'true' : tool.openSource === false ? 'false' : 'unknown'}
  data-order={tool.order}
  data-search={searchText}
>
  <div class="tool-card-top">
    <div class="tool-mark" aria-hidden="true">{initials}</div>
    <div class="tool-title">
      <h3><a href={detailHref}>{tool.name}</a></h3>
      <p class="tool-category">{tool.subcategory?.name ?? categoryName}</p>
    </div>
  </div>

  <p class="tool-description">{tool.description}</p>

  <div class="tool-meta" aria-label="Tool metadata">
    <span class="meta-chip">{categoryName}</span>
    {tool.pricing && <span class="meta-chip">{pricingLabel[tool.pricing]}</span>}
    {tool.openSource === true && <span class="meta-chip success">Open source</span>}
  </div>

  <div class="tool-actions">
    <button class="icon-text-button" type="button" data-save-tool={tool.id} aria-pressed="false">Save</button>
    <button class="icon-text-button" type="button" data-compare-tool={tool.id} aria-pressed="false">Compare</button>
    <a class="visit-link" href={tool.url} target="_blank" rel="noopener noreferrer">Visit ↗</a>
  </div>
</article>
