---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
// Back/forward arrows point the other way in right-to-left languages.
const directional = name === 'arrow-left' || name === 'arrow-right';
---

<svg class:list={['icon', directional && 'icon-dir', className]} aria-hidden="true">
  <use href={'#i-' + name}></use>
</svg>
