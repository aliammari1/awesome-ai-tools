---
import ArrowLeft from '@lucide/astro/icons/arrow-left';
import ArrowLeftRight from '@lucide/astro/icons/arrow-left-right';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUp from '@lucide/astro/icons/arrow-up';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Bookmark from '@lucide/astro/icons/bookmark';
import Check from '@lucide/astro/icons/check';
import LayoutGrid from '@lucide/astro/icons/layout-grid';
import Languages from '@lucide/astro/icons/languages';
import Link from '@lucide/astro/icons/link';
import List from '@lucide/astro/icons/list';
import Menu from '@lucide/astro/icons/menu';
import Moon from '@lucide/astro/icons/moon';
import RotateCcw from '@lucide/astro/icons/rotate-ccw';
import Search from '@lucide/astro/icons/search';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import Star from '@lucide/astro/icons/star';
import Sun from '@lucide/astro/icons/sun';
import X from '@lucide/astro/icons/x';

/**
 * Every icon the site uses is rendered once here and referenced with
 * <use href="#i-name">. Inlining the SVG in each of the 384 tool rows would add
 * hundreds of kilobytes to the home page.
 */
const icons = {
  'arrow-left': ArrowLeft,
  'arrow-right': ArrowRight,
  'arrow-up': ArrowUp,
  'arrow-up-right': ArrowUpRight,
  bookmark: Bookmark,
  check: Check,
  compare: ArrowLeftRight,
  filters: SlidersHorizontal,
  grid: LayoutGrid,
  languages: Languages,
  link: Link,
  list: List,
  menu: Menu,
  moon: Moon,
  reset: RotateCcw,
  search: Search,
  star: Star,
  sun: Sun,
  close: X,
};
---

<svg class="icon-sprite" aria-hidden="true" focusable="false">
  <symbol id="i-brand" viewBox="0 0 24 24">
    <path d="m5.6 18 6.4-12 6.4 12M8.25 13.9h7.5"></path>
  </symbol>
  <symbol id="i-compact" viewBox="0 0 24 24">
    <path d="M4 6h16M4 10h16M4 14h16M4 18h16"></path>
  </symbol>
  {Object.entries(icons).map(([name, Glyph]) => (
    <symbol id={'i-' + name} viewBox="0 0 24 24">
      <Glyph />
    </symbol>
  ))}
</svg>
