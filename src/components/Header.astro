---
import type { Locale } from '../lib/locales';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const prefix = '/' + locale;
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={prefix + '/'} aria-label="Awesome AI Tools home">
      <span class="brand-mark" aria-hidden="true">AI</span>
      <span>Awesome AI Tools</span>
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <a href={prefix + '/#directory'}>Tools</a>
      <a href={prefix + '/saved/'}>Saved</a>
      <a href={prefix + '/about/methodology/'}>Methodology</a>
      <a href={prefix + '/contribute/'}>Contribute</a>
      <a href="https://github.com/aliammari1/awesome-ai-tools" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>

    <div class="header-actions">
      <button class="search-shortcut" type="button" data-search-shortcut aria-label="Search tools">
        <span>Search</span>
        <kbd>⌘K</kbd>
      </button>
    </div>
  </div>
</header>
