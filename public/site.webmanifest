{
  "name": "Awesome AI Tools",
  "short_name": "AI Tools",
  "description": "A curated, plainly described open catalog of AI tools with local saved lists and comparison.",
  "start_url": "/en/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2459ee",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Search tools",
      "short_name": "Search",
      "description": "Search the AI tools directory",
      "url": "/en/?search=1#directory",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Saved workspace",
      "short_name": "Saved",
      "description": "Open your saved tools, lists and notes",
      "url": "/en/saved/",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Compare tools",
      "short_name": "Compare",
      "description": "Compare selected AI tools side by side",
      "url": "/en/compare/",
      "icons": [{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
